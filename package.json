{
  "name": "@yoda.digital/pi-remendra",
  "version": "2.3.0",
  "description": "Persistent memory for Pi — remembers what matters, forgets what's wrong.",
  "keywords": [
    "context",
    "knowledge",
    "learning",
    "long-term",
    "memory",
    "persistent",
    "pi",
    "pi-agent",
    "pi-extension",
    "pi-package",
    "recall"
  ],
  "homepage": "https://github.com/yoda-digital/pi-remendra#readme",
  "bugs": {
    "url": "https://github.com/yoda-digital/pi-remendra/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoda-digital/pi-remendra.git"
  },
  "bin": {
    "remendra-memory": "dist/v2/cli.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "docs/engineering.md",
    "docs/validation.md",
    "example-config.json"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "oxfmt . && oxfmt scripts",
    "format:check": "oxfmt . --check && oxfmt scripts --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check",
    "prepare": "node scripts/prepare.mjs",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt . --check",
    "verify": "pnpm check && pnpm test",
    "test:v2": "vitest run tests/v2",
    "test:smoke": "node scripts/v2-smoke.mjs && node scripts/v2-smoke.mjs --observer",
    "benchmark:v2": "node scripts/v2-benchmark.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "eslint": "10.12.0",
    "lint-staged": "17.6.0",
    "oxfmt": "^0.73.0",
    "prettier": "3.9.10",
    "simple-git-hooks": "^2.13.1",
    "tsup": "^9.0.0",
    "typebox": "1.3.37",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "better-sqlite3": ">=11.0.0",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  },
  "lint-staged": {
    "*.{ts,mjs,cjs}": [
      "eslint --fix"
    ],
    "*.{ts,mjs,cjs,json,jsonc}": [
      "oxfmt"
    ],
    "!(dist)/**/*.js": [
      "eslint --fix",
      "oxfmt"
    ]
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.2.2",
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "image": "https://raw.githubusercontent.com/yoda-digital/pi-remendra/main/docs/preview.png"
  }
}
