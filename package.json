{
  "name": "pi-remendra",
  "version": "2.0.0-alpha.2",
  "description": "Remember. Amend. Continue. Evidence-backed memory for Pi with scoped recall and transactional corrections.",
  "keywords": [
    "agents",
    "ai",
    "cli",
    "compact",
    "compaction",
    "observational-memory",
    "pi",
    "pi-agent",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "pi-remendra",
    "recall",
    "remendra"
  ],
  "homepage": "https://github.com/yoda-digital/pi-remendra#readme",
  "bugs": {
    "url": "https://github.com/yoda-digital/pi-remendra/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoda-digital/pi-remendra.git"
  },
  "bin": {
    "remendra-memory": "./dist/v2/cli.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "docs/V2.md",
    "docs/VALIDATION-V2.md",
    "example-config-v2.json",
    "scripts/prepare.mjs",
    "docs/LEGACY-README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "oxfmt . && oxfmt scripts",
    "format:check": "oxfmt . --check && oxfmt scripts --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check",
    "prepare": "node scripts/prepare.mjs",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt . --check",
    "verify": "pnpm check && pnpm test",
    "test:v2": "vitest run tests/v2",
    "test:smoke": "node scripts/v2-smoke.mjs && node scripts/v2-smoke.mjs --observer",
    "benchmark:v2": "node scripts/v2-benchmark.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "eslint": "10.9.1",
    "lint-staged": "17.4.1",
    "oxfmt": "^0.66.0",
    "prettier": "3.9.6",
    "simple-git-hooks": "^2.14.0",
    "tsup": "^8.5.1",
    "typebox": "1.3.25",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "typebox": "1.3.25"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix"
    ],
    "*.{ts,js,mjs,cjs,json,jsonc,md}": [
      "oxfmt"
    ]
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.2.2",
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
