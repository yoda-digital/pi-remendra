{
  "name": "@yoda.digital/pi-remendra",
  "version": "2.0.0",
  "description": "Persistent memory for Pi — remembers what matters, forgets what's wrong.",
  "keywords": [
    "pi",
    "pi-extension",
    "pi-agent",
    "pi-package",
    "memory",
    "recall",
    "persistent",
    "context",
    "knowledge",
    "long-term",
    "learning"
  ],
  "homepage": "https://github.com/yoda-digital/pi-remendra#readme",
  "bugs": {
    "url": "https://github.com/yoda-digital/pi-remendra/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoda-digital/pi-remendra.git"
  },
  "bin": {
    "remendra-memory": "dist/v2/cli.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "docs/engineering.md",
    "docs/validation.md",
    "example-config.json"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "oxfmt . && oxfmt scripts",
    "format:check": "oxfmt . --check && oxfmt scripts --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check",
    "prepare": "node scripts/prepare.mjs",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt . --check",
    "verify": "pnpm check && pnpm test",
    "test:v2": "vitest run tests/v2",
    "test:smoke": "node scripts/v2-smoke.mjs && node scripts/v2-smoke.mjs --observer",
    "benchmark:v2": "node scripts/v2-benchmark.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "eslint": "10.8.0",
    "lint-staged": "17.3.0",
    "oxfmt": "^0.64.0",
    "prettier": "3.9.6",
    "simple-git-hooks": "^2.13.1",
    "tsup": "^8.5.1",
    "typebox": "1.3.16",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "typebox": "1.3.16",
    "better-sqlite3": ">=11.0.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix"
    ],
    "*.{ts,js,mjs,cjs,json,jsonc}": [
      "oxfmt"
    ]
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.2.2",
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "image": "https://raw.githubusercontent.com/yoda-digital/pi-remendra/main/docs/preview.png"
  }
}
